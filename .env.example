# ========================================================
# Sweety - Blood Glucose Tracker Environment Variables
# Copy this file to .env in the project root and server/.env
# ========================================================

# Application Environment
NODE_ENV=development
PORT=5000

# PostgreSQL Database Configuration
DB_HOST=localhost
DB_PORT=5433
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=sweety_db

# Alternative Connection String (Supported alongside discrete variables)
# DATABASE_URL=postgresql://postgres:postgres@localhost:5433/sweety_db

# JSON Web Token Secret & Expiry
JWT_SECRET=super_secret_jwt_key_sweety_2026_change_in_production
JWT_EXPIRES_IN=7d

# Frontend Client Origin (for CORS)
CLIENT_URL=http://localhost:5173

# Frontend Environment (client/.env)
# VITE_API_URL=http://localhost:5000/api
